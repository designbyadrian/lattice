<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.designbyadrian.lattice</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Lattice</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.designbyadrian.lattice</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lattice</string>
			</array>
		</dict>
	</array>
	<key>NSAccessibilityUsageDescription</key>
	<string>Lattice needs Accessibility to arrange your windows.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Lattice can show live window previews in the overview when Screen Recording is allowed.</string>
	<!-- Sparkle 2: EdDSA public key. Replace SUPublicEDKey with the real public key from
	     1Password / GitHub Actions secrets at release time. Never commit the private key. -->
	<key>SUFeedURL</key>
	<string>https://designbyadrian.github.io/lattice/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_SPARKLE_EDDSA_PUBLIC_KEY_FROM_SECRETS</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
